# ═══════════════════════════════════════════════════════════════════
# EXAMPLE — Copy this to terraform.tfvars and fill in YOUR values
# DO NOT commit terraform.tfvars to Git (it has secrets!)
# ═══════════════════════════════════════════════════════════════════

# AWS
aws_region      = "us-east-1"
cluster_name    = "ep10-enterprise-cluster"
cluster_version = "1.31"
vpc_cidr        = "10.0.0.0/16"

# Bastion
bastion_instance_type = "t2.medium"

# Harness Platform (REQUIRED)
harness_account_id     = "YOUR_HARNESS_ACCOUNT_ID"         # Account Settings → Overview
harness_api_key        = "YOUR_API_KEY"                    # My Profile → API Keys → + Token
harness_delegate_token = "YOUR_DELEGATE_TOKEN"             # Project Settings → Delegates → Tokens
harness_org_id         = "default"
harness_project_id     = "HarnessCICDZerotoHero"

# Delegate (HA = 2 replicas)
delegate_name      = "eks-k8s-delegate"
delegate_replicas  = 2
delegate_image_tag = "24.04.83502"

# Monitoring
grafana_admin_password = "admin123"

# Networking (REQUIRED — your domain)
domain_name    = "yourdomain.com"
hosted_zone_id = ""                     # Only needed if Terraform manages Route53

# GitOps (REQUIRED)
github_username = "YOUR-GITHUB-USERNAME"
